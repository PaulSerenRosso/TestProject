{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log   *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",      
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u   origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u      origin spike/*)"
    ],
    "ask": [
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}               